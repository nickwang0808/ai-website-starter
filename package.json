{
  "name": "ai-website-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "start": "npm run dev",
    "check": "astro check && npm run test && prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "build": "astro build && node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check:publish": "node scripts/check-publish.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.11",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "wrangler": "4.161.0",
    "yaml": "2.9.1"
  }
}
