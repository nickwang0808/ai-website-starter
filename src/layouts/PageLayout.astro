---
import '../assets/styles/tailwind.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  noindex?: boolean;
}

const { title = site.name, noindex = false } = Astro.props;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : undefined;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site.description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {(!site.publishReady || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body class="font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:p-4"
    >
      Skip to content
    </a>
    {!site.publishReady && (
      <aside class="bg-primary px-5 py-3 text-center text-sm text-white">
        Local draft · Bracketed text is a placeholder, not a business claim.
      </aside>
    )}
    <header class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5 px-5 py-6 md:px-8">
      <a href="/" class="text-lg font-bold tracking-tight">
        {site.name}
      </a>
      <nav aria-label="Main navigation" class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium">
        <a href="/#services" class="hover:underline">
          Services
        </a>
        <a href="/#about" class="hover:underline">
          About
        </a>
        <a href="/#contact" class="hover:underline">
          Get in touch <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="mx-auto flex max-w-7xl flex-wrap justify-between gap-4 border-t border-primary/15 px-5 py-8 text-sm text-muted md:px-8">
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
      <a href="/#contact" class="underline underline-offset-4">
        Get in touch
      </a>
    </footer>
  </body>
</html>
