---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
---

<PageLayout title="Page not found" noindex>
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="mb-5 text-sm font-bold tracking-widest text-secondary">404</p>
    <h1 class="font-heading text-4xl text-heading">This page isn't here.</h1>
    <p class="mt-5 mb-8 text-lg text-muted">Try the homepage, or get in touch from there.</p>
    <Button href="/">Back to the homepage</Button>
  </section>
</PageLayout>
